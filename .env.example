# ========================================
# Digital Campus - Environment Template
# ========================================
# Copy to services/backend/.env for local dev, or services/backend/.env.prod for server
# NEVER commit .env to git!

# ── Application
SECRET_KEY=change-me-to-at-least-32-random-chars  # openssl rand -hex 32
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database — HYBRID (choose ONE primary)
# Laptop dev / tests (zero setup):
DATABASE_URL=sqlite:///./digital_campus.db
# Production Postgres (Docker):
# DATABASE_URL=postgresql+psycopg2://dc_user:dc_pass@db:5432/digital_campus

# Optional offline replica (Pattern B) — only if you need plane/offline mode:
# DATABASE_URL_LOCAL=sqlite:///./digital_campus_local.db

# ── Embeddings / vectors
EMBED_DIM=1536

# ── Redis / Celery (optional, Docker provides)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── LLM keys (optional)
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── CORS
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
