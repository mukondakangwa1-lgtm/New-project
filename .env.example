# ========================================
# Digital Campus Unified App - Environment
# ========================================

# Backend
BACKEND_SECRET_KEY=changeme-in-production
BACKEND_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# Local / HQ PC: sqlite is fine
# Public launch: use free Neon Postgres
DATABASE_URL=sqlite:///./digital_campus.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=

# Campus KUDOS is the in-app guide. Local 270-agent HQ uses KUDOS_MODE=hq
KUDOS_MODE=campus_help
QUOTA_SAFE=true
CORS_ORIGINS=*
