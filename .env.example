# ========================================
# Digital Campus - Deployment Environment
# ========================================
# Root .env values are consumed by docker-compose.prod.yml
# (Postgres credentials only). Copy to .env on the host and
# replace the password with a long random value.
#
# Backend/LLM/security settings live in services/backend/.env
# (copy services/backend/.env.example, see its comments).

POSTGRES_DB=digital_campus
POSTGRES_USER=dc_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
