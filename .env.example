# ========================================
# Digital Campus - Environment Template
# Copy to .env for local dev
# NEVER commit .env to git!
# ========================================

# ── Application
SECRET_KEY=change-me-to-at-least-32-random-chars  # openssl rand -hex 32
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database — Hybrid: PostgreSQL (prod) + SQLite (laptop)
# Laptop (zero setup, file = DB):
DATABASE_URL=sqlite:///./digital_campus.db
# Docker Postgres (prod):
# DATABASE_URL=postgresql+psycopg2://dc_user:dc_pass@db:5432/digital_campus
# Inside Docker compose service name: postgresql+psycopg2://dc_user:dc_pass@db:5432/digital_campus

# Optional offline replica (Pattern B):
# DATABASE_URL_LOCAL=sqlite:///./digital_campus_local.db

# ── Object Storage — MinIO / S3 (connected)
# Local MinIO (free, private, offline) — start: docker-compose up -d minio
S3_ENDPOINT=http://localhost:9000
# Inside Docker: S3_ENDPOINT=http://minio:9000
S3_BUCKET=campus-media
S3_ACCESS_KEY=dc_minio
S3_SECRET_KEY=dc_minio_pass_32chars_change_me
S3_REGION=us-east-1
S3_SECURE=false
S3_ENABLED=true
# Prod Cloudflare R2 / B2:
# S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# S3_ACCESS_KEY=YOUR_R2_KEY
# S3_SECRET_KEY=YOUR_R2_SECRET
# S3_SECURE=true

# ── Redis / Celery (connected)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Embeddings / vectors (pgvector on Postgres, fallback keyword search on SQLite)
EMBED_DIM=1536
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=

# ── Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
