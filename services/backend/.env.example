# Digital Campus - Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Security (REQUIRED - change this!)
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Database (Postgres for production)
# Example: postgresql://user:password@db:5432/digital_campus
DATABASE_URL=postgresql://dc_user:dc_pass@db:5432/digital_campus

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}

# LLM API Keys — keep these on the 4GB HQ PC, not on the public campus cloud
# Public campus KUDOS works from seeded help docs with zero quota.
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# campus_help = public in-app guide (default for launch)
# hq = local 270-agent KUDOS on your PC
KUDOS_MODE=campus_help
QUOTA_SAFE=true

# CORS (comma-separated origins for production)
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*
