# Digital Campus - Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Security (REQUIRED - change this!)
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Database (Postgres for production)
# Example: postgresql://user:password@db:5432/digital_campus
DATABASE_URL=postgresql://dc_user:dc_pass@db:5432/digital_campus
# Use Alembic migrations in production. Set true only for local throwaway DBs.
AUTO_CREATE_TABLES=false

# Environment: development or production. Production fails fast if
# SECRET_KEY is left at its default or DEBUG is enabled.
APP_ENV=development

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Backups (PostgreSQL, via pg_dump)
BACKUP_DIR=backups
BACKUP_KEEP=14
CELERY_BROKER_URL=${REDIS_URL}

# Postgres credentials consumed by docker-compose (repo-root .env too).
# Run `make env-provision` to generate fresh random values automatically
# Run `make env-provision` to generate strong random values automatically.
POSTGRES_DB=digital_campus
POSTGRES_USER=dc_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Object storage — MinIO with local-disk fallback.
# STORAGE_BACKEND: auto (MinIO when configured, else local), minio, local
STORAGE_BACKEND=minio
# MinIO endpoint reachable by the backend (compose service name + port).
MINIO_ENDPOINT=minio:9000
# Scoped application access key/secret — provisioned by deploy/minio/init.sh
# from the same credentials in the repo-root .env.
MINIO_ACCESS_KEY=replace-with-minio-application-key
MINIO_SECRET_KEY=replace-with-minio-application-secret
MINIO_BUCKET=kudos
# TLS between backend and MinIO (true when MinIO serves HTTPS).
MINIO_SECURE=false
MINIO_REGION=us-east-1
# Root bootstrap credentials for the MinIO server (compose-level only).
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
# When STORAGE_BACKEND=local, objects land here (relative to repo root).
STORAGE_LOCAL_DIR=uploads

# LLM runtime (use auto or one provider ID)
LLM_PROVIDER=auto
# When LLM_PROVIDER=auto, KUDOS asks every configured LLM at once and his
# brain picks the best answer (grounded, on-topic, high quality). Set to
# false to fall back to sequential "first provider that answers".
KUDOS_BRAIN_SELECT=true
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_ENABLED=false
# Local Ollama: http://host.docker.internal:11434 (no key required)
# Ollama Cloud: https://ollama.com with an API key from ollama.com/settings/keys
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30

# Optional semantic retrieval (requires OpenAI embeddings + pgvector)
SEMANTIC_SEARCH_ENABLED=false
EMBED_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Internal Model Context Protocol gateway
MCP_AUTH_TOKEN=replace-with-a-random-internal-token
MCP_REQUIRE_AUTH=true
MCP_ALLOW_MUTATIONS=false

# LLM API Keys (optional - add at least one for KUDOS AI)
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Additional application keys (comma- or newline-separated)
# API_KEYS=key-one,key-two

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000
