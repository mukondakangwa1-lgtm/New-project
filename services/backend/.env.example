# Digital Campus - Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Security (REQUIRED - change this!)
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Database (Postgres for production)
# Example: postgresql://user:password@db:5432/digital_campus
DATABASE_URL=postgresql://dc_user:dc_pass@db:5432/digital_campus
# Use Alembic migrations in production. Set true only for local throwaway DBs.
AUTO_CREATE_TABLES=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}

# LLM runtime (use auto or one provider ID)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_ENABLED=false
# Local Ollama: http://host.docker.internal:11434 (no key required)
# Ollama Cloud: https://ollama.com with an API key from ollama.com/settings/keys
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30

# Optional semantic retrieval (requires OpenAI embeddings + pgvector)
SEMANTIC_SEARCH_ENABLED=false
EMBED_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Internal Model Context Protocol gateway
MCP_AUTH_TOKEN=replace-with-a-random-internal-token
MCP_REQUIRE_AUTH=true
MCP_ALLOW_MUTATIONS=false

# LLM API Keys (optional - add at least one for KUDOS AI)
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Additional application keys (comma- or newline-separated)
# API_KEYS=key-one,key-two

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000
