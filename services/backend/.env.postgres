# ========================================
# PostgreSQL — Production / Docker
# ========================================
# 1. Create DB/user in Postgres (once):
#    psql -U postgres -c "CREATE USER dc_user WITH PASSWORD 'dc_pass';"
#    psql -U postgres -c "CREATE DATABASE digital_campus OWNER dc_user;"
#    psql -U postgres -c "GRANT ALL PRIVILEGES ON DATABASE digital_campus TO dc_user;"
# 2. Copy this to .env and run:  python scripts/init_db.py --seed
#    OR with Docker:  docker-compose up -d
DATABASE_URL=postgresql+psycopg2://dc_user:dc_pass@localhost:5432/digital_campus
# For Docker compose service name 'db':
# DATABASE_URL=postgresql+psycopg2://dc_user:dc_pass@db:5432/digital_campus

SECRET_KEY=change-me-prod-openssl-rand-hex-32
DEBUG=false
HOST=0.0.0.0
PORT=8000
EMBED_DIM=1536
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
