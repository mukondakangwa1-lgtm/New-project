# ========================================
# MinIO — Free Secure S3 (copy to .env or keep separate)
# ========================================
# Local Docker MinIO (offline, zero cost)
S3_ENDPOINT=http://localhost:9000
# Inside Docker compose use: S3_ENDPOINT=http://minio:9000
S3_BUCKET=campus-media
S3_ACCESS_KEY=dc_minio
S3_SECRET_KEY=dc_minio_pass_32chars_change_me
S3_REGION=us-east-1
S3_SECURE=false
# Prod Cloudflare R2 example (same code, just change endpoint):
# S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
# S3_SECRET_KEY=YOUR_R2_SECRET_KEY
# S3_SECURE=true
