# Used at build time so Next.js can proxy /api/* to the FastAPI host.
BACKEND_URL=http://127.0.0.1:8000

# Optional public API origin (same value as BACKEND_URL in production).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Direct WebSocket origin for Chat (wss://your-backend.onrender.com).
# Leave empty in local dev so Chat uses the current host.
NEXT_PUBLIC_WS_URL=
