# ---------------------------------------------------------------------------
# Digital Campus — deployment variables for docker-compose.prod.yml
# Copy to `.env` in the repo root and run `make env-provision` to fill in
# missing secrets automatically (nothing here is a real secret).
# ---------------------------------------------------------------------------

# Postgres — db service + backend DATABASE_URL
POSTGRES_DB=digital_campus
POSTGRES_USER=dc_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# MinIO bootstrap (root account — used only by the MinIO server and minio-init)
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password-8-chars-min

# MinIO application account (scoped write-only policy; used by backend/worker/backup)
MINIO_ACCESS_KEY=replace-with-minio-app-key
MINIO_SECRET_KEY=replace-with-minio-app-secret
MINIO_BUCKET=kudos

# Backup retention for the in-compose scheduler (daily pg_dump)
BACKUP_KEEP=14

# Backend signing secret. docker-compose.prod.yml loads services/backend/.env
# via env_file — keep in sync with SECRET_KEY there (make env-provision does
# this for you).
# SECRET_KEY=replace-with-a-random-string-at-least-32-chars