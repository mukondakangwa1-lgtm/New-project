# Values consumed by docker-compose.prod.yml for Postgres.
# Copy to .env on the deployment host and replace the password.
POSTGRES_DB=digital_campus
POSTGRES_USER=dc_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend signing secret. docker-compose.prod.yml loads services/backend/.env
# via env_file — keep this value in sync with the SECRET_KEY there, or set it
# as an environment variable of the same name on the host.
# SECRET_KEY=replace-with-a-random-string-at-least-32-chars
